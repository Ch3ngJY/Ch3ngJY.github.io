-
    var giscus = theme.comment_giscus || {}
    var isPlaceholderGiscusValue = function (value) {
        if (!value) return true
        var text = String(value).trim()
        return /^(OWNER\/REPO|REPO_ID|CATEGORY|CATEGORY_ID|GISCUS_|YOUR_|\[.*\])$/i.test(text)
    }
    var missingGiscusConfig = isPlaceholderGiscusValue(giscus.repo)
        || isPlaceholderGiscusValue(giscus.repo_id)
        || isPlaceholderGiscusValue(giscus.category)
        || isPlaceholderGiscusValue(giscus.category_id)
    var giscusMapping = giscus.mapping || 'pathname'
    var giscusStrict = giscus.strict === 1 || giscus.strict === '1' ? '1' : '0'
    var giscusReactions = giscus.reactions_enabled === 0 || giscus.reactions_enabled === '0' ? '0' : '1'
    var giscusMetadata = giscus.emit_metadata === 1 || giscus.emit_metadata === '1' ? '1' : '0'
    var giscusInputPosition = giscus.input_position || 'bottom'
    var giscusLang = giscus.lang || 'zh-CN'
    var giscusLoading = giscus.loading || 'lazy'
    var giscusThemeLight = giscus.theme_light || 'light'
    var giscusThemeDark = giscus.theme_dark || 'dark'

if giscus.enable
    article.mt-6.comment-container.giscus-comment-container#giscusComments(
        data-giscus-repo=giscus.repo
        data-giscus-repo-id=giscus.repo_id
        data-giscus-category=giscus.category
        data-giscus-category-id=giscus.category_id
        data-giscus-mapping=giscusMapping
        data-giscus-strict=giscusStrict
        data-giscus-reactions-enabled=giscusReactions
        data-giscus-emit-metadata=giscusMetadata
        data-giscus-input-position=giscusInputPosition
        data-giscus-lang=giscusLang
        data-giscus-loading=giscusLoading
        data-giscus-theme-light=giscusThemeLight
        data-giscus-theme-dark=giscusThemeDark
        data-giscus-config-missing=missingGiscusConfig ? 'true' : 'false'
    )
        header.giscus-comment-heading
            span.giscus-comment-count#giscusCommentCount(aria-live='polite') 0 条评论
            span.giscus-comment-separator(aria-hidden='true') —
            span.giscus-comment-powered
                | 由&nbsp;
                a(href='https://giscus.app/zh-CN', target='_blank', rel='noopener noreferrer') giscus
                | &nbsp;提供支持
        if missingGiscusConfig
            p.giscus-config-hint.is-hidden 请先在 themes/claudia/_config.yml 填写 comment_giscus 的 repo、repo_id、category、category_id。
        else
            div.giscus
